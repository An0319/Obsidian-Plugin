{
  "name": "obsidian-smart-notes",
  "version": "0.1.1",
  "description": "Obsidian 智能笔记整理插件：四层可切换引擎，自动分类与文件夹整理，免费、本地优先",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "note-organizer",
    "tfidf",
    "ollama"
  ],
  "author": "MonkeyCode",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.4.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
